ODOO_URL=https://odoo-stg.peltierpro.com
ODOO_DATABASE=odoo-stg.peltierpro.com
ODOO_API_KEY=your_odoo_api_key_here

TRANSPORT=streamable-http
HOST=0.0.0.0
PORT=8000
REQUEST_TIMEOUT_SECONDS=30
MAX_RESULTS=50
LOG_LEVEL=INFO

# Public URL of this MCP deployment.
MCP_PUBLIC_URL=https://your-public-host.example.com

# OAuth disabled for first local test.
AUTH_ENABLED=false

# Enable these for Claude remote use:
AUTH_ISSUER_URL=https://auth.example.com
AUTH_RESOURCE_SERVER_URL=https://your-public-host.example.com/mcp
AUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
AUTH_AUDIENCE=https://your-public-host.example.com/mcp
AUTH_REQUIRED_SCOPES=odoo.read
AUTH_ALGORITHMS=RS256

# Per-account MCP tool permissions.
# Keep false until OAuth is working and you have placed real JWT identifiers
# into config/permissions.yaml.
PERMISSIONS_ENABLED=false
PERMISSIONS_FILE=config/permissions.yaml
